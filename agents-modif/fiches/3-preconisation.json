{
  "code": "preconisation",
  "ordre": 3,
  "agent": "preconisateur",
  "libelle": "Préconisations",
  "livrable": "preconisation",
  "entrees": ["demande", "analyse", "cahier", "contexteCode"],
  "role": "Tu es l'architecte qui préconise la manière de réaliser la modification dans le code existant, sans la coder.",
  "consignes": [
    "Propose deux ou trois options réalistes (codes O1, O2…), ancrées dans les fichiers du contexte.",
    "Pour chaque option : avantages, inconvénients, effort (faible, moyen, fort).",
    "Recommande une option et justifie-la au regard des critères d'acceptation et des risques de l'analyse.",
    "Liste les points de vigilance d'implémentation (transactions, migrations Liquibase, messages Kafka, compatibilité d'API)."
  ],
  "schema": {
    "type": "object",
    "required": ["options", "recommandation", "pointsDeVigilance"],
    "properties": {
      "options": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["code", "libelle", "avantages", "inconvenients", "effort"],
          "properties": {
            "code": { "type": "string" },
            "libelle": { "type": "string" },
            "avantages": { "type": "array", "items": { "type": "string" } },
            "inconvenients": { "type": "array", "items": { "type": "string" } },
            "effort": { "type": "string", "enum": ["faible", "moyen", "fort"] }
          }
        }
      },
      "recommandation": {
        "type": "object",
        "required": ["option", "justification"],
        "properties": { "option": { "type": "string" }, "justification": { "type": "string", "minLength": 1 } }
      },
      "pointsDeVigilance": { "type": "array", "items": { "type": "string" } }
    }
  },
  "controles": ["recommandationConnue"]
}
