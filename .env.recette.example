# Variables de la pile de recette (compose.recette.yaml).
# Copier en .env.recette, droits 600 ; jamais versionné (.gitignore).
# vm/preparer-vm.sh l'écrit lui-même, avec des mots de passe tirés au hasard.
#
# Les mots de passe entrent dans des URL de connexion : lettres et chiffres
# seulement (ni @, ni :, ni /, ni %).

# Superutilisateur PostgreSQL : sert à la seule initialisation du volume
PG_MOT_DE_PASSE_ADMIN=a-remplacer
# Rôle recette : propriétaire des schémas, utilisé par le lanceur et l'interface
RECETTE_MOT_DE_PASSE=a-remplacer
# Rôle recette_lecture : lecture seule, requêtes SQL des tests définis en base
RECETTE_LECTURE_MOT_DE_PASSE=a-remplacer

# Port de l'interface, publié sur 127.0.0.1 de la VM
INTERFACE_PORT=8080
# Authentification HTTP de l'interface, facultative : les deux, ou aucune
# (une seule des deux : l'interface refuse de démarrer)
INTERFACE_UTILISATEUR=
INTERFACE_MOT_DE_PASSE=
# Noms d'hôte permis en plus de localhost, 127.0.0.1 et [::1], séparés par des
# virgules (garde contre le rebond DNS) : par exemple un nom donné au tunnel
INTERFACE_HOTES_PERMIS=

# Délai maximal d'une requête SQL de test, en millisecondes (défaut 5000)
RECETTE_DELAI_SQL_MS=5000

# Fuseau des dates affichées et enregistrées
TZ=Europe/Paris
