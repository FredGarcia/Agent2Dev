# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════════════════
#  Image de la recette : lanceur de campagnes et interface (compose.recette.yaml)
# ═══════════════════════════════════════════════════════════════════════════
#
#  Les outils dont les suites ont besoin : Node (même majeure que le résolveur),
#  git, jq, bash, le client Docker et son plugin Compose (le démon est celui de
#  la VM, par son socket), gitleaks (contrôle de 3.2, version et empreinte
#  épinglées), et les dépendances du dépôt, développement compris (pg).
#
#  Le code n'est pas copié dans l'image : recette/entree.sh recopie au
#  démarrage le dépôt monté sur /depot. Reconstruire l'image n'est nécessaire
#  que si package-lock.json ou cet en-tête d'outils change.

FROM node:22.23.3-trixie-slim

ARG GITLEAKS_VERSION=8.21.2
# Empreintes SHA-256 des archives de la release, relevées une fois et épinglées
# ici : une release altérée après coup ne passe pas (l'empreinte publiée dans
# la même release ne le garantirait pas).
ARG GITLEAKS_SHA256_AMD64=5bc41815076e6ed6ef8fbecc9d9b75bcae31f39029ceb55da08086315316e3ba
ARG GITLEAKS_SHA256_ARM64=654c935542c89f565aabe7bf7c6c500830f116c114f0aeb509d2460c1ac2e6da

# Outils de base, puis le client Docker depuis le dépôt apt officiel de Docker
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git jq \
 && install -m 0755 -d /etc/apt/keyrings \
 && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
 && chmod a+r /etc/apt/keyrings/docker.asc \
 && printf 'Types: deb\nURIs: https://download.docker.com/linux/debian\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
      "$(. /etc/os-release && echo "$VERSION_CODENAME")" "$(dpkg --print-architecture)" \
      > /etc/apt/sources.list.d/docker.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory '*'

# gitleaks, vérifié contre son empreinte épinglée
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) arch=x64; empreinte="$GITLEAKS_SHA256_AMD64" ;; \
      arm64) arch=arm64; empreinte="$GITLEAKS_SHA256_ARM64" ;; \
      *) echo "architecture non prise en charge par cette image : $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    archive="gitleaks_${GITLEAKS_VERSION}_linux_${arch}.tar.gz"; \
    cd /tmp; \
    curl -fsSLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/$archive"; \
    echo "$empreinte  $archive" | sha256sum -c -; \
    tar -xzf "$archive" -C /usr/local/bin gitleaks; \
    rm -f "$archive"; \
    gitleaks version

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

COPY --chmod=755 recette/entree.sh /usr/local/bin/recette-entree

ENV RECETTE_DEPOT=/depot \
    RECETTE_TRAVAIL=/tmp/travail
ENTRYPOINT ["recette-entree"]
CMD ["campagne"]
